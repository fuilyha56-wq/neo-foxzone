{
  "name": "neo-foxzone",
  "display_name": "Neo-FoxZone",
  "version": "0.1.5",
  "description": "基于 OneBot Expand 的 QQ 空间说说插件，支持完整管理、评论轮询自动回复、自治互动与可替换 AI 生图发布",
  "author": "Lycoris-flower",
  "license": "AGPL-3.0",
  "dependencies": {
    "plugins": [
      "onebot_expand>=1.0.17"
    ],
    "components": [
      "onebot_expand:service:qzone_service",
      "onebot_expand:service:account_service"
    ]
  },
  "include": [
    {
      "component_type": "service",
      "component_name": "qzone_service",
      "dependencies": [
        "onebot_expand:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "command",
      "component_name": "neo-foxzone",
      "dependencies": [
        "neo-foxzone:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_list_posts",
      "dependencies": [
        "neo-foxzone:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_list_feeds",
      "dependencies": [
        "neo-foxzone:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_publish",
      "dependencies": [
        "neo-foxzone:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_publish_generated",
      "dependencies": [
        "neo-foxzone:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_delete",
      "dependencies": [
        "neo-foxzone:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_like",
      "dependencies": [
        "neo-foxzone:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_unlike",
      "dependencies": [
        "neo-foxzone:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_comment",
      "dependencies": [
        "neo-foxzone:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_set_blacklist",
      "dependencies": [
        "neo-foxzone:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_set_visibility",
      "dependencies": [
        "neo-foxzone:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "config",
      "component_name": "config",
      "dependencies": [],
      "enabled": true
    }
  ],
  "entry_point": "plugin.py",
  "api_version": {
    "llm_api": "1.0.0",
    "service_api": "1.0.0",
    "storage_api": "1.0.0"
  },
  "min_core_version": "1.0.0",
  "python_dependencies": [],
  "dependencies_required": true,
  "categories": [
    "tool"
  ],
  "tags": [
    "qq",
    "qzone",
    "说说",
    "onebot",
    "onebot-expand",
    "napcat",
    "snowluma"
  ]
}