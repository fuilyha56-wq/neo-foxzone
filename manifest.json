{
  "name": "neo-foxzone",
  "display_name": "Neo FoxZone",
  "version": "0.1.0",
  "description": "基于 OneBot Expand 的 QQ 空间说说全功能插件，无需 Cookie，支持查询、发布、删除、点赞、评论、黑名单与可见权限管理",
  "author": "MoFox Team",
  "license": "AGPL-3.0",
  "dependencies": {
    "plugins": [
      "onebot_expand>=1.0.13"
    ],
    "components": [
      "onebot_expand:service:qzone_service"
    ]
  },
  "include": [
    {
      "component_type": "service",
      "component_name": "neo_foxzone_service",
      "dependencies": [
        "onebot_expand:service:qzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "command",
      "component_name": "neofoxzone",
      "dependencies": [
        "neo-foxzone:service:neo_foxzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_list_posts",
      "dependencies": [
        "neo-foxzone:service:neo_foxzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_list_feeds",
      "dependencies": [
        "neo-foxzone:service:neo_foxzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_publish",
      "dependencies": [
        "neo-foxzone:service:neo_foxzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_delete",
      "dependencies": [
        "neo-foxzone:service:neo_foxzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_like",
      "dependencies": [
        "neo-foxzone:service:neo_foxzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_unlike",
      "dependencies": [
        "neo-foxzone:service:neo_foxzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_comment",
      "dependencies": [
        "neo-foxzone:service:neo_foxzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_set_blacklist",
      "dependencies": [
        "neo-foxzone:service:neo_foxzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "tool",
      "component_name": "neo_foxzone_set_visibility",
      "dependencies": [
        "neo-foxzone:service:neo_foxzone_service"
      ],
      "enabled": true
    },
    {
      "component_type": "config",
      "component_name": "config",
      "dependencies": [],
      "enabled": true
    }
  ],
  "entry_point": "plugin.py",
  "api_version": "1.0.0",
  "min_core_version": "1.0.0",
  "python_dependencies": [],
  "dependencies_required": true,
  "categories": [
    "tool"
  ],
  "tags": [
    "qq",
    "qzone",
    "说说",
    "onebot",
    "onebot-expand",
    "napcat",
    "snowluma"
  ]
}